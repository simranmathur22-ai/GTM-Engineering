# Shared API configuration for researcher-agent and email composer.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=12.5
GEMINI_RESEARCH_COOLDOWN_SECONDS=60.5
GEMINI_TRANSIENT_RETRY_BASE_SECONDS=2
SERPER_API_KEY=your-serper-api-key-here
HUBSPOT_CLIENT_ID=your-hubspot-oauth-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-oauth-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:5001/hubspot/callback
FLASK_SECRET_KEY=generate-a-random-secret-key
